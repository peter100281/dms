<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>DMS – Papierkorb</title>

  <link rel="stylesheet" href="/static/app.css">
</head>

<body>

<header class="topbar">

  <strong><%= appName %></strong>

  <div class="topbar-right">
    <span><%= username %></span>

    <form method="post" action="/logout">
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <button class="button-secondary">
        Abmelden
      </button>
    </form>
  </div>

</header>


<div class="app-layout">

  <aside class="sidebar">

    <nav>
      <a href="/inbox">📥 Sammler</a>
      <a href="/documents">📄 Dokumente</a>
      <a href="/timeline">📅 Chronologisch</a>
      <a href="/categories">🏷 Kategorien</a>
      <a href="/search">🔎 Suche</a>

      <a href="/trash" class="active">
        🗑 Papierkorb
      </a>

      <% if (isAdmin) { %>
      <a href="/account">👤 Mein Konto</a>

      <a href="/settings">⚙ Einstellungen</a>
      <a href="/system">⚙ System</a>
      <a href="/users">👥 Benutzer</a>
      <% } %>
    </nav>

  </aside>


  <main class="content">

    <div class="page-title">
      <h1>Papierkorb</h1>

      <p>
        Gelöschte Dokumente wiederherstellen oder endgültig entfernen.
      </p>
    </div>


    <% if (message) { %>

      <div class="message">
        <%= message %>
      </div>

    <% } %>


    <div class="archive-list">

      <% if (documents.length === 0) { %>

        <div class="empty-state">
          <h3>Der Papierkorb ist leer</h3>
        </div>

      <% } %>


      <% documents.forEach(doc => { %>

        <article class="document-card">

          <div class="document-icon">
            PDF
          </div>


          <div class="document-info">

            <h3>
              <%= doc.title %>
            </h3>


            <div class="document-meta">

              <span>
                Gelöscht:
                <%= new Date(
                  doc.deleted_at
                ).toLocaleString(
                  'de-DE',
                  {
                    dateStyle: 'medium',
                    timeStyle: 'short'
                  }
                ) %>
              </span>


              <% if (doc.category_name) { %>

                <span>•</span>

                <span>
                  🏷
                  <%= doc.parent_category_name
                    ? doc.parent_category_name
                      + ' → '
                      + doc.category_name
                    : doc.category_name
                  %>
                </span>

              <% } %>

            </div>

          </div>


          <div class="document-actions">

            <a
              href="/documents/<%= doc.id %>/file"
              target="_blank"
              class="button-secondary"
            >
              PDF
            </a>


            <form
              method="post"
              action="/trash/<%= doc.id %>/restore"
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <button type="submit">
                Wiederherstellen
              </button>
            </form>
            <% if (isAdmin) { %>
            <!-- ADMIN-DELETE-BEGIN -->

            <form
              method="post"
              action="/trash/<%= doc.id %>/delete"
              data-confirm="Dokument und zugehörige Dateien wirklich endgültig löschen? Dieser Vorgang kann nicht rückgängig gemacht werden."
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <button
                type="submit"
                class="danger-button"
              >
                Endgültig löschen
              </button>

            </form>

            <!-- ADMIN-DELETE-END -->
            <% } %>

          </div>

        </article>

      <% }); %>

    </div>

  </main>

</div>


<script
  src="/static/app.js"
  defer
></script>

</body>
</html>

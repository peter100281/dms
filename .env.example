# ---------------------------------------------------------
# DMS – Beispielkonfiguration
# ---------------------------------------------------------

# Zeitzone
TZ=Europe/Berlin


# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

POSTGRES_DB=dms
POSTGRES_USER=dms

# Unbedingt durch ein starkes Passwort ersetzen.
POSTGRES_PASSWORD=CHANGE_ME


# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------

# Unbedingt durch ein starkes Passwort ersetzen.
REDIS_PASSWORD=CHANGE_ME


# ---------------------------------------------------------
# Anwendung
# ---------------------------------------------------------

APP_PORT=3000

# Standardmäßig nur lokal erreichbar.
# Für Zugriff aus dem LAN z. B.:
# APP_BIND_ADDRESS=0.0.0.0
APP_BIND_ADDRESS=127.0.0.1

# Mit folgendem Befehl erzeugen:
# openssl rand -hex 32
APP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# false bei direktem HTTP-Zugriff
# true bei Betrieb über HTTPS
COOKIE_SECURE=false

# Leer lassen, wenn kein Reverse Proxy verwendet wird.
# Bei Reverse Proxy dessen IP eintragen.
TRUST_PROXY=


# ---------------------------------------------------------
# Persistente Daten
# ---------------------------------------------------------

# Basisverzeichnis für Dokumente, Datenbank,
# Redis, Mailarchiv, Statusdaten und Backups.
DMS_DATA_DIR=/data/dms
